<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>j2act-retained-jdbc</artifactId>
  <name>j2act-retained-jdbc</name>
  <description>
    Retained State snapshots in the app's database (ADR 0026), through a DataSource the app or container
    already has. No dependencies beyond j2act-core and java.sql; schema scripts per database ship in the jar.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-core</artifactId>
    </dependency>

    <!-- Test: the two embedded databases, the second one file-based. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
