<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.then00p.j2act</groupId>
  <artifactId>j2act-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>j2act</name>
  <description>Server-driven web UI for Java: components render HTML on the server and patch the page over a socket.</description>
  <url>https://github.com/THEN00P/j2act</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>THEN00P</id>
      <name>THEN00P</name>
      <url>https://github.com/THEN00P</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/THEN00P/j2act</url>
    <connection>scm:git:https://github.com/THEN00P/j2act.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/THEN00P/j2act.git</developerConnection>
  </scm>

  <!-- The Vite examples load j2act-maven-plugin as a build extension, which Maven resolves before
       it builds anything, so they are their own build: ./mvnw install, then ./mvnw -f examples install. -->
  <modules>
    <module>j2act-codegen</module>
    <module>j2act-core</module>
    <module>j2act-html</module>
    <module>j2act-router</module>
    <module>j2act-processor</module>
    <module>j2act-spring</module>
    <module>j2act-jakarta</module>
    <module>j2act-retained-jdbc</module>
    <module>j2act-maven-plugin</module>
    <module>examples/counter-spring</module>
    <module>examples/counter-jakarta</module>
  </modules>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.3</junit.version>
    <jackson.version>2.13.5</jackson.version>
    <spring-boot.version>3.5.16</spring-boot.version>
  </properties>

  <!-- The Spring Boot BOM is imported only by the Spring modules: it pins javax-era jakarta.* APIs. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-html</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-router</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-spring</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-jakarta</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.then00p.j2act</groupId>
        <artifactId>j2act-retained-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>build-jdk</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <!-- Built on 21 or 25. The bytecode stays release 11, and 17 for the Spring modules. -->
                  <version>[21,)</version>
                  <message>Build with JDK 21 or newer (CI uses 21 and 25). Libraries still target Java 11 bytecode except the Spring modules (17).</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      ./mvnw -Prelease deploy uploads to Maven Central (ADR 0029). Signing runs in-process with the
      armored key in MAVEN_GPG_KEY and its passphrase in MAVEN_GPG_PASSPHRASE, so no gpg program is
      needed. The upload waits for validation; -DautoPublish=true, as the release workflow passes,
      also releases it, otherwise it waits in the Central Portal to be published or dropped.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <deploymentName>j2act ${project.version}</deploymentName>
              <!-- Build-time only, or demos. -->
              <excludeArtifacts>
                <excludeArtifact>j2act-codegen</excludeArtifact>
                <excludeArtifact>counter-spring</excludeArtifact>
                <excludeArtifact>counter-jakarta</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
