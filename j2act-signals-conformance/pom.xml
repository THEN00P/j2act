<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.then00p.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>j2act-signals-conformance</artifactId>
  <name>j2act-signals-conformance</name>
  <description>
    Runs Solid's own test files, unchanged, against the Java port of its engine (ADR 0033). Not published.
    prepare.mjs fetches Solid at the pinned commit and bundles the tests; GraalJS runs them.
    One file: ./mvnw -pl j2act-signals-conformance test -Dsolid.file=createSignal
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.source.skip>true</maven.source.skip>
    <graal.version>24.2.2</graal.version>
    <solid.file></solid.file>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.then00p.j2act</groupId>
      <artifactId>j2act-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>polyglot</artifactId>
      <version>${graal.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>js-community</artifactId>
      <version>${graal.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>bundle-solid-tests</id>
            <phase>generate-test-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>node</executable>
              <arguments>
                <argument>prepare.mjs</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <solid.file>${solid.file}</solid.file>
          </systemPropertyVariables>
          <trimStackTrace>true</trimStackTrace>
          <!-- Truffle asserts interop invariants a JS Proxy breaks; the tests assert for themselves. -->
          <enableAssertions>false</enableAssertions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
