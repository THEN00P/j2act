<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>j2act-processor</artifactId>
  <name>j2act-processor</name>
  <description>Build-time checks (ADR 0008) for javac and ECJ. Goes on the annotation processor path, never the runtime classpath.</description>
  <properties>
    <ecj.version>3.46.100</ecj.version>
  </properties>
  <dependencies>
    <!-- Test only: fixtures compile against the real API, under javac and under ECJ. -->
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-html</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-router</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>${ecj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- The service file names a class this very compilation produces. -->
          <proc>none</proc>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
