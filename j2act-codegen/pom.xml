<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>j2act-codegen</artifactId>
  <name>j2act-codegen</name>
  <description>
    Build-time generator for the tag API (GlobalAttributes, typed tag classes, TagCreator).
    Not published. Regenerate: ./mvnw -pl j2act-codegen compile exec:java
    Refresh data: ./mvnw -pl j2act-codegen compile exec:java -Dexec.mainClass=j2act.codegen.UpdateData
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <exec.mainClass>j2act.codegen.Generate</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <arguments>
            <argument>${project.basedir}/..</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
