<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>team-dashboard</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <!-- Spring Boot 3+ needs Java 17; the same pages run on WildFly 27+ on Java 11 via j2act-jakarta. -->
    <java.version>17</java.version>
    <j2act.version>0.1.0-SNAPSHOT</j2act.version>
    <spring-boot.version>3.5.16</spring-boot.version>
  </properties>
  <dependencies>
    <dependency><groupId>dev.j2act</groupId><artifactId>j2act-core</artifactId><version>${j2act.version}</version></dependency>
    <dependency><groupId>dev.j2act</groupId><artifactId>j2act-html</artifactId><version>${j2act.version}</version></dependency>
    <dependency><groupId>dev.j2act</groupId><artifactId>j2act-router</artifactId><version>${j2act.version}</version></dependency>
    <dependency><groupId>dev.j2act</groupId><artifactId>j2act-spring</artifactId><version>${j2act.version}</version></dependency>
    <dependency><groupId>dev.j2act</groupId><artifactId>j2act-jakarta</artifactId><version>${j2act.version}</version></dependency>
    <!-- Host stack, not J2ACT deps: JPA, JTA annotations, scheduling and jakarta.inject. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId><version>${spring-boot.version}</version></dependency>
    <dependency><groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId><version>2.0.1</version></dependency>
  </dependencies>
</project>
