<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ts-npm</artifactId>
  <name>ts-npm</name>
  <description>TypeScript client modules with npm packages, CSS imports and CSS modules, built by Vite (ADR 0022, 0023).</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-html</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-router</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-spring</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Vite, tsc, Node, the processor and the IDE setup, as defaults (ADR 0025). -->
      <plugin>
        <groupId>dev.j2act</groupId>
        <artifactId>j2act-maven-plugin</artifactId>
        <version>${project.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
