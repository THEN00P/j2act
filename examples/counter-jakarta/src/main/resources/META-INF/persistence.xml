<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="people">
    <!-- WildFly's bundled in-memory H2 datasource. -->
    <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>
    <class>com.example.jakarta.model.Person</class>
    <properties>
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <!-- The Retained State table (ADR 0026), from the script j2act-retained-jdbc ships. The
           default datasource is ExampleDS too; a real app runs the script with its migrations. -->
      <property name="jakarta.persistence.schema-generation.create-source" value="metadata-then-script"/>
      <property name="jakarta.persistence.schema-generation.create-script-source" value="j2act/jdbc/schema-h2.sql"/>
    </properties>
  </persistence-unit>
</persistence>
