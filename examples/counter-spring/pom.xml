<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>counter-spring</artifactId>
  <name>counter-spring</name>
  <description>First-slice demo on Spring Boot 3+ (Java 17): counters, keyed rows, validated queries, foreign-thread push, forms.</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-html</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-router</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <!-- Explicit: Boot 3.0's BOM does not manage it. -->
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- npm packages as Maven artifacts: their import maps and files reach the page (ADR 0022). -->
    <dependency>
      <groupId>org.mvnpm</groupId>
      <artifactId>chart.js</artifactId>
      <version>4.5.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.mvnpm</groupId>
      <artifactId>quill</artifactId>
      <version>2.0.3</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Client modules and the files they import sit next to their Java class (ADR 0022).
         Overriding <resources> drops the default, so src/main/resources is listed again. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.js</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- The build-time checks (ADR 0008). The processor is never a runtime dependency. -->
          <annotationProcessorPaths>
            <path>
              <groupId>dev.j2act</groupId>
              <artifactId>j2act-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
