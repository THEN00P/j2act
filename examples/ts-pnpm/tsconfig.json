{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "rootDirs": ["src/main/java", ".j2act/types"]
  },
  "include": ["src/main/java/**/*.ts", ".j2act/types/**/*.d.ts"]
}
