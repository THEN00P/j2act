<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.j2act</groupId>
    <artifactId>j2act-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>vite-maven-wildfly</artifactId>
  <packaging>war</packaging>
  <name>vite-maven-wildfly</name>
  <description>
    TypeScript, npm packages, a CSS module and Tailwind through Vite (ADR 0023), in a WAR for
    WildFly 27+, with dev mode (ADR 0024) and the Maven plugin (ADR 0025).
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-jakarta</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-html</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.j2act</groupId>
      <artifactId>j2act-router</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <version>10.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>vite-maven-wildfly</finalName>
    <plugins>
      <!-- Vite, tsc, Node, the processor and the IDE setup, as defaults (ADR 0025). -->
      <plugin>
        <groupId>dev.j2act</groupId>
        <artifactId>j2act-maven-plugin</artifactId>
        <version>${project.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
